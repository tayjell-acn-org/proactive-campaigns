{
  "version": "2.0",
  "logging": {
    "logLevel": {
      "default": "None",
      "Function": "Information",
      "Host.Triggers.ServiceBus": "None",
      "Azure.Messaging.ServiceBus": "None",
      "Host.Triggers.CosmosDB": "None"
    }
  },
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.*, 5.0.0)"
  },
  "extensions": {
    "serviceBus": {
      "prefetchCount": 0,
      "messageHandlerOptions": {
        "autoComplete": true,
        "maxAutoRenewDuration": "00:05:00",
        "maxConcurrentCalls": 16
      }
    }
  }
}
